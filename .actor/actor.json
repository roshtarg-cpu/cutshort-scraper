{
  "actorSpecification": 1,
  "name": "cutshort-scraper",
  "title": "Cutshort Job Scraper",
  "description": "Extract job listings from Cutshort.io including title, company, location, salary, skills, and experience requirements. Works with Claude, ChatGPT, and AI agents via Apify MCP.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "output": {
    "schemaVersion": 1,
    "title": "Cutshort Job",
    "type": "object",
    "properties": {
      "scrapedAt": {
        "type": "string",
        "description": "ISO timestamp when the job was scraped",
        "editor": "textfield"
      },
      "jobId": {
        "type": "string",
        "description": "Unique job identifier",
        "editor": "textfield"
      },
      "title": {
        "type": "string",
        "description": "Job title",
        "editor": "textfield"
      },
      "url": {
        "type": "string",
        "description": "Job posting URL",
        "editor": "textfield"
      },
      "company": {
        "type": "string",
        "description": "Company name",
        "editor": "textfield"
      },
      "companyAlias": {
        "type": "string",
        "description": "Company URL alias",
        "editor": "textfield"
      },
      "location": {
        "type": "string",
        "description": "Job location(s)",
        "editor": "textfield"
      },
      "skills": {
        "type": "string",
        "description": "Required skills (comma-separated)",
        "editor": "textfield"
      },
      "experienceMin": {
        "type": "number",
        "description": "Minimum years of experience",
        "editor": "number"
      },
      "experienceMax": {
        "type": "number",
        "description": "Maximum years of experience",
        "editor": "number"
      },
      "salaryMin": {
        "type": "number",
        "description": "Minimum salary",
        "editor": "number"
      },
      "salaryMax": {
        "type": "number",
        "description": "Maximum salary",
        "editor": "number"
      },
      "salaryCurrency": {
        "type": "string",
        "description": "Salary currency code",
        "editor": "textfield"
      },
      "salaryText": {
        "type": "string",
        "description": "Formatted salary text",
        "editor": "textfield"
      },
      "remoteType": {
        "type": "string",
        "description": "Remote work policy",
        "editor": "textfield"
      },
      "jobType": {
        "type": "string",
        "description": "Job type (full_time, internship, etc.)",
        "editor": "textfield"
      },
      "description": {
        "type": "string",
        "description": "Job description (HTML)",
        "editor": "textarea"
      },
      "hiringForClient": {
        "type": "boolean",
        "description": "Whether hiring for a client company",
        "editor": "checkbox"
      },
      "postedBy": {
        "type": "string",
        "description": "Name of recruiter who posted",
        "editor": "textfield"
      }
    }
  }
}
