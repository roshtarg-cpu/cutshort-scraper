{
  "schemaVersion": 1,
  "title": "Cutshort Scraper Input",
  "type": "object",
  "description": "Configure the scraper parameters",
  "properties": {
    "searchQuery": {
      "type": "string",
      "title": "Search Query",
      "description": "Job title or skills to search (e.g., 'python', 'full-stack', 'data-science')",
      "editor": "textfield",
      "prefill": "python"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "City or region (e.g., 'Bangalore', 'Mumbai', 'Remote')",
      "editor": "textfield",
      "prefill": "Bangalore"
    },
    "maxResults": {
      "type": "integer",
      "title": "Max Results",
      "description": "Maximum number of jobs to scrape",
      "editor": "number",
      "minimum": 1,
      "maximum": 1000,
      "default": 50,
      "prefill": 10
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy configuration to use for requests",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      },
      "editor": "proxy"
    }
  },
  "required": ["searchQuery"]
}
